{
  "version": 2,
  "crons": [
    {
      "path": "/api/freeze",
      "schedule": "0 2 * * *"
    }
  ],
  "routes": [
    { "src": "/style.css", "dest": "/style.css" },
    { "src": "/app.js", "dest": "/app.js" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/sw.js", "dest": "/sw.js" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
